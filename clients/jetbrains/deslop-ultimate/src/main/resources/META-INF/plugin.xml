<idea-plugin>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>

    <!-- The Community/LSP4IJ build delivers the identical bridge and reuses the
         shared action id, file-editor type id, notification group, and server
         id. Both dependency sets are satisfiable on IDEA Ultimate, so allowing
         co-install would double-start the LSP and collide those ids. They are
         mutually exclusive by design. -->
    <incompatible-with>nimblesite.deslop.jetbrains.community</incompatible-with>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Deslop" displayType="BALLOON" />
        <platform.lsp.serverSupportProvider
            implementation="com.nimblesite.deslop.jetbrains.DeslopLspServerSupportProvider" />
        <fileEditorProvider
            implementation="com.nimblesite.deslop.jetbrains.DeslopHtmlReportEditorProvider" />
    </extensions>

    <actions>
        <action id="Deslop.OpenHtmlReport"
                class="com.nimblesite.deslop.jetbrains.DeslopUltimateOpenHtmlReportAction"
                text="Deslop: Open HTML Report"
                description="Render the live Deslop duplicate-code report in a browser tab.">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
