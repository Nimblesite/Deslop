{#- [SITE-PYTHON-LANDING] The Python landing page, shared by /python/ and /zh/python/.
    Copy comes from _data/pythonLanding.json; the film from docFilms.json; the
    Python glyph from the extension's own artwork via _data/languages.js. -#}
{% set copy = pythonLanding[lang or "en"] %}
{% set python = languages | selectattr("id", "equalto", "python") | first %}
{% macro installButton(label) %}<a class="py-btn" href="vscode:extension/Nimblesite.deslop-live" data-cta="install"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14"/></svg>{{ label }}</a>{% endmacro %}
<div class="py">
  <section class="py-hero" aria-labelledby="py-title">
    <div class="py-hero__aurora" aria-hidden="true"></div>
    <div class="py-hero__text">
      <p class="py-chip"><span class="py-chip__icon">{{ python.icon | safe }}</span>{{ copy.eyebrow }}</p>
      <h1 id="py-title">{{ copy.headline }} <em>{{ copy.headlineEm }}</em></h1>
      <p class="py-hero__lede">{{ copy.lede }}</p>
      <div class="py-cta">{{ installButton(copy.install) }}</div>
      <p class="py-hero__note">{{ copy.installNote }}</p>
      <p class="py-hero__note"><a href="https://marketplace.visualstudio.com/items?itemName=Nimblesite.deslop-live">{{ copy.marketplace }}</a></p>
    </div>
    <div class="py-film" id="film">
      {% set docFilm = "python-click" %}
      {% include "partials/doc-film.njk" %}
    </div>
  </section>

  <section class="py-section" aria-labelledby="py-film-title">
    <p class="py-eyebrow">{{ copy.filmEyebrow }}</p>
    <h2 id="py-film-title">{{ copy.filmTitle }}</h2>
    <p class="py-lede">{{ copy.filmLede }}</p>
  </section>

  <section class="py-section" aria-labelledby="py-clones-title">
    <p class="py-eyebrow">{{ copy.clonesEyebrow }}</p>
    <h2 id="py-clones-title">{{ copy.clonesTitle }}</h2>
    <p class="py-lede">{{ copy.clonesLede }}</p>
    <ol class="py-cards">
      {% for clone in copy.clones %}
      <li class="py-card">
        <span class="py-card__kind">{{ clone.kind }}</span>
        <h3>{{ clone.title }}</h3>
        <div class="py-card__code">{% highlight "python" %}{{ clone.code | safe }}{% endhighlight %}</div>
        <p class="py-card__where">{{ clone.where }}</p>
        <p>{{ clone.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </section>

  <section class="py-section py-lint" aria-labelledby="py-lint-title">
    <p class="py-eyebrow">{{ copy.lintEyebrow }}</p>
    <h2 id="py-lint-title">{{ copy.lintTitle }}</h2>
    {% for paragraph in copy.lintParagraphs %}<p class="py-lede">{{ paragraph | safe }}</p>{% endfor %}
  </section>

  <section class="py-section" aria-labelledby="py-steps-title">
    <p class="py-eyebrow">{{ copy.stepsEyebrow }}</p>
    <h2 id="py-steps-title">{{ copy.stepsTitle }}</h2>
    <ol class="py-steps">
      {% for step in copy.steps %}<li class="py-step"><h3>{{ step.title }}</h3><p>{{ step.text }}</p></li>{% endfor %}
    </ol>
  </section>

  <section class="py-section py-faq" aria-labelledby="py-faq-title">
    <h2 id="py-faq-title">{{ copy.faqTitle }}</h2>
    {% for item in copy.faq %}
    <details class="py-faq__item"{% if loop.first %} open{% endif %}><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>
    {% endfor %}
  </section>

  <section class="py-closing" aria-labelledby="py-closing-title">
    <div class="py-hero__aurora" aria-hidden="true"></div>
    <h2 id="py-closing-title">{{ copy.closingTitle }}</h2>
    <p>{{ copy.closingText }}</p>
    <div class="py-cta py-cta--center">
      {{ installButton(copy.install) }}
      <a class="py-link" href="{{ '/zh/docs/' if lang == 'zh' else '/docs/' }}">{{ copy.learnMore }} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": copy.faq | faqEntities
} | jsonValue | safe }}
</script>
