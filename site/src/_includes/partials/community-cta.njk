{#- Community CTA band — shared by the en (/) and zh (/zh/) home pages so the
    markup lives in exactly one place. Copy comes from i18n.json (community.*)
    keyed by the page language; the invite URL has its single source of truth
    in site.json (site.discord). -#}
{% set currentLang = lang | default('en') %}
<section class="community">
  <div class="community__inner">
    <div class="eyebrow-chip"><span>{{ "community.eyebrow" | t(currentLang) | default("Community") }}</span></div>
    <h2 class="community__title">{{ "community.title" | t(currentLang) | default("Building Deslop in the open.") }}</h2>
    <p class="community__lede">{{ "community.lede" | t(currentLang) | default("Questions, bug reports, feature requests, or just want to talk duplicate detection and AI codegen? Join the Deslop Discord — users and contributors both welcome.") }}</p>
    <a href="{{ site.discord }}" class="btn-discord" target="_blank" rel="noopener noreferrer">
      <svg class="btn-discord__mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.371-.291a.074.074 0 0 1 .078-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.245.198.372.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.548-13.66a.061.061 0 0 0-.031-.029ZM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/></svg>
      {{ "community.cta" | t(currentLang) | default("Join the Discord") }}
    </a>
  </div>
</section>
