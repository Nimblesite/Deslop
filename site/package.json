{
  "name": "deslop-site",
  "version": "0.0.0-dev",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "issues:generate": "python3 ../scripts/issues/generate_issue_report.py --output src/assets/data/issues.json",
    "build": "npm run issues:generate && npx @11ty/eleventy",
    "clean": "rm -rf _site",
    "pretest": "npm run issues:generate",
    "test": "playwright test"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "eleventy-plugin-techdoc": "^0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2"
  }
}
